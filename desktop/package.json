{
  "name": "castle-wars",
  "productName": "Castle WARS",
  "version": "1.0.1",
  "description": "Castle WARS – strategická bitva hradů",
  "author": {
    "name": "BrosWars Studio"
  },
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cz.hradprotihradu.hra",
    "productName": "Castle WARS",
    "files": [
      "main.js",
      "icon.png",
      "hra/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "CastleWARS-Windows.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.strategy-games",
      "identity": "-",
      "artifactName": "CastleWARS-Mac.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Game",
      "artifactName": "CastleWARS-Linux.AppImage",
      "maintainer": "BrosWars Studio",
      "vendor": "BrosWars Studio"
    },
    "publish": null,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Castle WARS",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "Castle WARS",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 570,
        "height": 380
      }
    },
    "copyright": "© 2026 BrosWars Studio"
  }
}